o:Sass::Tree::RootNode:@template"^=/* 
SASS for Custom Styles 
Author: Matt Le 
Company: Resound Creative
Location: Tempe, AZ 
Guess What? URemarkable.
*/

 @import "colors.scss";
 @import "mixins.scss";
 @import "variables.scss";
 @import "fonts.scss";
 @import "../fonts/fontawesome/scss/font-awesome.scss";

 /* Media Specific Styles */

 // Readjusts Backgrounds
 @media (max-width: 767px) {
 	.fr-navbar {
 		background-color: $fr-gray;
		background-image: none !important;	 
	}
	.fr-navbar.user {
		background-color: $fr-yellow;
	}
	#oreFormFirstName {
		margin-bottom: 15px;
	}
	.well-poll {
	margin-left: 10px !important;
	}

	.well-truck {
		margin-left: 10px !important;
		margin-top: 50px;
	}
	.lesson-sum {
		margin: auto !important;
		margin-top: 30px !important;
	}
	.offering {
		clear: both;
	}
	.db-support {
		.meter {
			width: 400px;
		}
	}

	/* Collapsible Navigation */
	h3.current-amount {
		margin-top: 80%;
	}
	.nav .navbar-nav {
		min-height: 200px;
		padding-bottom: 10px;
	}
	.homepage.fr-navbar .navbar-nav a:hover {
		border: 0px !important;
		color: #3F3F40 !important;
		background-color: #fed02f;
	}
	.homepage.fr-navbar .navbar-nav a {
		padding: 20px 0px 15px !important;
		margin: 0px 25px 0px !important;
		color: #FFFFFF;
	}
	.navbar-nav {
		background-color: #3F3F40;
		text-align: center;
		margin: 0px -15px 7.5px !important;
	}
	.homepage#nav-affix {
		height: 53px !important;
	}
	.navbar-default .navbar-collapse, .navbar-default .navbar-form {
		border: 0px !important;
	}

	/* Homepage */

	.bg-family { 
		background: url("../img/frontiers-off-road-encounters-family-fade.jpg") bottom center no-repeat #B9CCEA;
		background-size: contain;
	}
 }

 @media (max-width: 991px) {
 	.footer-icons {
		div {
			border-left: 0px !important;
			min-height: 25px !important;
			padding: 0 20px;
		}
		div:last-child {
			border-right: 0px !important;
		}
	}
	.fr-footer .footer-icons img {
	margin: auto;
	padding-top: 0px;
	}
	.footer-icons {
		margin-top: -15px !important;
	}
	.well-truck .img {
		margin: 0px !important;
	}
	h3.current-amount {
	margin-top: 3%;
	}
 }

 @media ( min-width: 768px ) { 
    .navbar > .container {
        text-align: center;
    }
    .navbar-header,.navbar-brand,.navbar .navbar-nav,.navbar .navbar-nav > li {
        float: none;
        display: inline-block;
    }
    .collapse.navbar-collapse {
        width: auto;
        clear: none;
    }
    .well-email-cta {
		.name {
			div:first-child {
				padding-right: 2px;	
			}
			div:last-child {
				padding-left: 2px;
			}
		}
	}
	h3.current-amount {
	margin-top: 80%;
	}
}

/* Global */
body {
	font-family: Avenir;
	font-size: $fr-text-1x;
}
h1, h2, h3, h4 {
	font-weight: bold;
	text-transform: uppercase;
}
h2 {
	font-size: $fr-text-2x; 
	font-family: 'KomikaAxis', sans-serif;
	margin-bottom: 30px;
	margin-top: 0px;
	text-transform: uppercase;
}
.lowcase {
	text-transform: lowercase;
}
.komika {
	font-family: 'KomikaAxis', sans-serif;
}
input:focus {
	outline: 0;
}
.table>tbody>tr>td {
	border-top: 0px solid #ddd;
}

/* Semantic Declarations */
.form-control {
	height: 45px;
}

.bg-center {
	background-repeat: no-repeat;
	background-size: cover;
	background-position: center;
}

.border {
	border: 1px solid red;
}

.btn {
	@include border-radius(5px);
	text-transform: uppercase;
	color: $fr-white;
}

.btn-sm {
	font-family: 'KomikaAxis', sans-serif;
	background-color: $fr-yellow;
	letter-spacing: .05em;
}

.btn-fr-1 {
	padding: 22px 25px 25px 28px; 
	font-family: 'KomikaAxis', sans-serif;
	font-size: $fr-text-1x;
	background-color: $fr-yellow;
	letter-spacing: .05em;
	margin: 15px 0;
}

.btn-fr-1:hover {
	background-color: $fr-yellow-hover;
	color: $fr-white;
}

.btn-fr-2 {
	@extend .btn-fr-1;
	background-color: $fr-green; 
}

.btn-fr-2:hover {
	background-color: $fr-green-hover; 
}

.btn-fr-3 {
	@extend .btn-fr-1;
	background-color: $fr-red;
}

.btn-fr-3:hover {
	background-color: $fr-red-hover;
}

.fr-yellow {
	color: $fr-yellow;
}

.fr-green {
	color: $fr-green;
}

.fr-gray {
	color: $fr-gray;
}
.fr-white {
	color: $fr-white;
}
.bold {
	font-weight: bold;
}
.link-sm {
	a {
		color: $fr-gray;
		font-weight: lighter;
		font-size: $fr-text-1x * 0.8;
	}
}
.reset {
	padding: 0px;
	margin: 0px;
}

// Transform Rotate clases - to create a new rotate class follow the syntax passing the paremeter, degrees
.rotate {
	@include rotate(0deg);
}
.rotate45 {
	@include rotate(45deg);
}
.rotate90 {
	@include rotate(90deg);
}

form.btn-sm input[type=checkbox]:checked { background-color: $fr-green; }

// Wells

.well-fr {
	@include border-radius(0px);
	padding: 40px 60px; 
	color: $fr-white;
	p {
		font-size: $fr-text-1x;
	}
}

.well-gray-bg {
	@extend .well-fr;
	background-color: rgba(65, 64, 66, 0.6);
}

/* Frontiers Offroad Encounters Styles */

// Header 

#ore-header {
	@extend .bg-center;
	min-height: 560px;
	background-image: url('../img/#{$seo-img}-header.jpg'); 
}

#ore-header-email {
	@extend .bg-center;
	min-height: 880px;
	background-position: top;
	background-image: url('../img/#{$seo-img}-family-full.jpg'); 
	padding-top: 30px;
}

.font-a {
	font-family: Avenir; 
}

.sign-in {
	background-color: $fr-gray;
	color: #bcbcbc;
	border-radius: 0 0 10px 10px;
	width: 127px;
}

.sign-in:hover {
	color: $fr-white;
}

.header-logo {
	margin: 20px 0; 
}

.header-logo-fr {
	background-image: url("../img/frontiers-off-road-encounters-logo.png");
	float: left;
	height: 109px;
	position: absolute;
	width: 213px;
	background-repeat: no-repeat;
	text-indent: 9999em;
	top: -6px;
	background-size: 211px 105px;
}

.header-text {
	text-transform: uppercase;
	color: $fr-white;
	font-size: $fr-text-3x;
	letter-spacing: 0.18em;
	line-height: 1.15em;
	p:first-child {
		font-weight: bold;
		margin: 20px 0 0 0; 
	}
	p:nth-child(2) {
		letter-spacing: 0.14em;
		margin: 0 0 40px 0; 
	}
}

.email-landing {
	margin: 20px 0 0;
	letter-spacing: 0.29em;
	p:nth-child(2) {
		letter-spacing: 0.22em;
		margin: 0 0 40px 0; 
	}
}

.cta-video {
	margin-bottom: 70px;
}

// Navbar
.navbar {
	border: 0px ; 
}

.navbar-default .navbar-nav > li > a { color: $fr-white; }

.navbar.navbar-default.navbar-static-top.fr-navbar { border-bottom: 3px solid #ffffff; }
.fr-navbar, .fr-footer {
	@extend .bg-center;
	background-image: url('../img/fr-menu-bg.png'); 
	font-size: $fr-text-half;
	margin-bottom: 0px;
	.navbar-nav a {
		color: $fr-white;
		font-size: 1.6em;
		text-transform: uppercase;
		font-weight: bold;
		padding: 25px; 
	}
	.navbar-nav a:hover {
		color: $fr-gray !important;
		border-bottom: 3px dotted $fr-gray;

	}
	/* .footer-links a:hover {
		color: $fr-yellow;
		text-decoration: none;
	} */
}

.homepage.navbar.navbar-default.navbar-static-top.fr-navbar { border-bottom: none; }

.homepage#nav-affix { height: 70px; }

.homepage.fr-navbar {
	.navbar-nav a { 
		padding: 25px 0px 5px;
		margin: 0px 25px 17px;
	}
	.navbar-nav a:hover {
		color: $fr-yellow !important;
		border-bottom: 3px dotted $fr-yellow;

	}
}

ul.navbar-nav li a:hover { color: #414042; border-bottom: 0px dotted #414042; }

#nav-affix {
	width: 100%;
	height: 108px;
}

#nav-affix.affix {
	top: 0px;
}

.navbar-header {
	float: right;
}

// Map 

.bg-map {
	@extend .bg-center;
	min-height: 646px;
	background-image: url('../img/#{$seo-img}-map.png'); 
	width:100%;
	margin:0px;
}

.well-adventure {
	@extend .well-fr;
	background-color: rgba(65, 64, 66, 0.6);
	margin: 120px 20px; 
}

.country-badges {
	margin-top: 30px;
	padding: 0px;
	.fr-badge {
		padding: 10px;
	}
}

//Email CTA 

.well-email-cta {
	@extend .well-adventure;
	margin: 0 auto;
	max-width: 600px;
	padding: 40px; 
	margin-top: 80px;
	margin-bottom: 100px;
}

.fr-header2 {
	font-family: Avenir;
	font-size: 1.685em;
	letter-spacing: 0.18em;
}

.sect-beyond {
	margin: 80px 0;
	padding: 0 20px;
	h2 {
		font-size: $fr-text-3x;
		font-weight: normal;
		letter-spacing: 16px;
	}
	p {
		font-size: $fr-text-1x;
		color: $fr-green-dark;
		margin: 0px;
		padding: 0px 0 2px 0;
	}
	a {
		font-size: $fr-text-1x;
	}
}

// Challenge

.bg-challenge {
	margin: 90px 0;
	padding: 0 20px;
}

.well-challenge {
	p {
		color: $fr-gray;
		font-size: $fr-text-1x;
	}
}

.goal-meter {
	margin: 0 auto;
	padding-bottom: 30px;
}

#animated-arrow.animate {
	transform:rotate(-55deg);
	-ms-transform:rotate(-55deg); /* IE 9 */
	-webkit-transform:rotate(-55deg); /* Opera, Chrome, and Safari */
	-webkit-transition: -webkit-transform 1s ease-in;
}

.animated-arrow {
	position: absolute;
	z-index: 500;
	left: -130px;
	top: 41px;
	width:289px;
	/* width: 59.3%; */
	padding: 0px;
}

.current-amount {
	margin-top: 80%;
}

// Family

.bg-family {
	@extend .bg-center;
	min-height: 674px;
	background-image: url('../img/#{$seo-img}-family-fade.jpg');
	padding: 0 20px;
	width:100%;
	margin:0px;
	.container {
		margin-top: 50px;
	}
	p {
		color: $fr-gray;
		font-size: $fr-text-1x;
	}
}

// Footer

.fr-footer {
	padding: 30px 0;
	width: 100%;
	margin: 0px;
	border-top: 3px $fr-white solid;
	.container, .fr-container {
		padding: 0 10px;
	}
	.footer-links, .fr-icon {
		padding: 5px 0 0 0;
		a {
			color: $fr-white;
			text-transform: uppercase;
		}
		a:hover {
			color: $fr-yellow;
			text-decoration: none;
		}
		div {
			margin: 5px 0;
			padding-right: 0px;
		}
	}
	.footer-icons {
		padding: 0px;
		img {
			margin: auto;
			padding-top: 10px; 
		}
		div {
			border-left: 1px solid $fr-lt-gray;
			min-height: 70px;
			padding: 0 20px;
		}
		div:first-child {
			padding-top: 10px;
		}
		div:last-child {
			border-right: 1px solid $fr-lt-gray;
		}
	}
	.fr-icon {
		padding-top: 16px;
	}
	div.missionexus {
		padding-top:12px;
	}
	.copyright {
		padding-left: 10px;
	}
}

.footer-links {
	padding-left: 20px;
	li {
		list-style: none;
		float: left;
	}
}

// Subfooter 

#subfooter {
	@extend .bg-center;
	min-height: 240px;
	background-image: url('../img/#{$seo-img}-feet.jpg'); 
	padding-top: 35px;
	color: $fr-white;
	letter-spacing: 5px;
	text-transform: uppercase;
	h2 {
		font-weight: lighter;
		font-family: Avenir;
		margin-bottom: 0px;
	}
	p {
		padding: 15px 0;
	}
	span {
		margin: 0 12px;
	}
	.btn {
		padding: 10px;
		font-size: $fr-text-half;
		font-family: Avenir;
		margin-top: -4px;
	}
}

.email-sign-up {
	margin: 25px 0;
}

.btn-well {
	width: 275px;
	margin: auto;
	background-color: white;
	height: 53px;
	padding: 5px;
	border-radius: 5px;
	.btn-fr-2 {
		margin: 0px;
	}
	input {
		border: 0px;
		font-size: 1.2em;
		height: 40px;
		width: 197px;
		padding: 5px 0 0 10px;
		color: $fr-gray;
	}
	input:focus {
		outline: 0;
	}
}

// Episode Styles 

.fr-navbar.user {
	background-image: url('../img/fr-menu-bg-yellow.png'); 
}

.navbar-nav.navbar-right.user a {
	padding: 30px 0px 5px;
	margin: 0px 30px 14px;
}

.row.tab {

}

#ore-episodes-header {
	@extend .bg-center;
	min-height: 600px;
	background-image: url('../img/#{$seo-img}-episode-bg.jpg'); 
	.container.video {
	}
}

.bg-episode {
	margin: 40px 0;
	h2, img {
		margin-top:20px;
	}
	p {
		font-size: $fr-text-1x;
	}
}

.video-content { margin: auto; padding:25px 0px; height: 700px; }

.video-content iframe { width: 100%; height: 100%; }

.bg-poll-truck {
	@extend .bg-center;
	min-height: 600px;
	background-image: url('../img/#{$seo-img}-episode-camels.jpg');
	padding: 75px 20px;
	width: 100%;
	margin: 0px;
	.well-gray-bg {
		min-height: 420px;
		p {
			font-size: $fr-text-1x * 0.9;
		}
	}
	.btn {
		width: 100%;
		margin: 25px 0 35px 0;
	}
	h3 {
		text-transform: uppercase;
	}
}

.well-poll {
	margin-left: 50px;
	padding: 35px;
	h3 {
		line-height: 1.4em;
	}
}

.well-truck {
	padding: 35px;
	//margin: 50px 0 30px 55px;
	h3 {
		margin: 0px;
		padding: 0px;
	}
	img {
		margin: 0 auto;
	}
	.img {
		margin: 20px;
		min-height: 150px;
	}
	img:last-child {
		padding-top: 20px;
	}
}

.activities {
	padding: 50px 20px;
	width: 100%;
	margin: 0px;
}

.toggle {
	a {
		color: $fr-yellow;
		font-size: $fr-text-1x;
		text-transform: uppercase;
	}
}

.activity-row {
	border-bottom: 2px solid #d9d9d9;
	padding: 40px; 
	h3 {
		text-transform: uppercase;
		font-family: 'KomikaAxis', sans-serif;
	}
	p{
		font-size: $fr-text-1x;
	}
}

.img-desat {
	@include img-desat(1);
}

//Student DB Styles 

.student-bg-map {
	@extend .bg-center;
	background-image: url('../img/#{$seo-img}-student-bg-map.png');
}

.status-bar {
	div {
		border: 1px solid $fr-yellow;
		height: 10px;
	}
	.complete {
		background-color: $fr-yellow;
	}
}

.well-lesson {
	padding:20px;
	margin: 2px 0;
	h2,h3 {
		font-size: $fr-text-1x;
		padding: 0px;
		margin: 5px 0; 
	}
	h2 {
		letter-spacing: 0.15em;
	}
	h3 {
		color: $fr-yellow;
		text-transform: uppercase;
		font-weight: 100;
	}
}

.student-bg-badge {
	@extend .bg-center;
	min-height:400px;
	background-image: url('../img/#{$seo-img}-student-bg-badges.png');
}

.section {
	padding: 40px 0;
}

.lesson-sum {
	width: 457px;
	height: 271px;
	margin: 150px 0 0 100px;
	.well-lesson {
		margin: 0px;
		p {
			font-size: $fr-text-1x * 0.9;
			padding-top: 11px;
			font-weight: lighter;
		}
		.badges {
			background-image: url("../img/db-badge.png");
			background-repeat: no-repeat;
			width: 100%;
			padding: 0;
			padding-left: 25px;
			height: 26px;
			font-weight: bold;
		}
		.btn {
			font-family: 'KomikaAxis', sans-serif;	
			background-color: $fr-yellow;
			letter-spacing: .05em;
		}
	}
}

.lesson-sum-bg {
	height: 272px;
	background-image: url('../img/db-lesson-sum.jpg'); 
	@extend .bg-center;
}

.badge-total {
	color: $fr-white;
	font-size: $fr-text-1x;
	p:first-child {
		width: 200px;
		margin: 10px auto;
		margin-bottom: 40px;
	}
	p:nth-child(2) {
		height: 15px;
		text-transform: uppercase;
		margin: 0px;
	}
	p:nth-child(3) {
		margin: 0;
		height: 85px;
	}
	p:last-child {
		text-transform: uppercase;
	}
}

.subscript {
	color: $fr-white;
	font-size: $fr-text-2x;
	font-weight: bold;
	float: left;
	margin-top: -40px;
	margin-left: 110px;
}

.badge-total-count {
	font-weight: bold;
	font-size: $fr-text-3x * 1.3 ;
}

.student-bg-support {
	.btn {
		width: 100%;
	}
}

.section-support {
	padding: 40px;	
	h2 {
		margin-bottom: 50px;
	}
	input {
		width: 140px;
		padding: 0 5px;
		color: $fr-green;
		font-weight: bold;
		border: 1px solid $fr-green;
	}
	input, label {
		font-size: 2.85em;
	}

}
.subtext {
	font-size: $fr-text-1x;
	margin: 25px 0;
}
.low {
	font-size: $fr-text-1x * 1.2; 
	color: $fr-green;
	font-weight: bold;
	float: left;
}

.bracket-label {
	width: 250px;
	margin: auto;
}

.high {
	@extend .low;
	float: right;
	a {
		color: $fr-gray;
		font-weight: lighter;
		font-size: $fr-text-half * 0.6;
	}
	p:nth-child(2) {
		line-height: 0px;
	}
	p {
		margin: 0px;
	}
}

.make-offering {
	text-transform: uppercase;
	text-align: left;
	padding-right: 0px;
	margin: 20px 0;
	p {
		margin: 0px;
		padding: 0px;
		margin-left: 25px;
		letter-spacing: .05em;
	}
	p:first-child {
		font-size: $fr-text-1x * 1.2;
	}
	p:last-child {
		font-size: $fr-text-1x * 0.92;
	}
}

.offering-amnt {
	margin: 20px 0;
	padding: 0px;
	text-align: left;
}

// Parent DB styles 

#parent-db-title {
	margin: 50px 0;
	p {
		font-size: $fr-text-1x;
		max-width: 800px;
		margin: auto;
	}
}

.section-db-student {
	h2 {
		margin: 10px 0;
	}
}

.db-activity {
	font-size: $fr-text-1x;
	h3 {
		text-transform: uppercase;
	}
	table {
		a {
			color: $fr-gray;
			text-decoration: underline;
		}
	}
}

.meter-img {
	float: left; 
}

.meter-scale {
	height: 240px;
	float: left;
	margin-left: 20px;
	p {
		margin: 0px;
	}

}

.meter-text {
	font-size: 1.608em;
	color: $fr-green;
	font-weight: bold;
}

.meter-text.low {
	padding-top: 175px;
}

.offering {
	h3 {
		@extend .reset;
	}
	p {
		font-size: $fr-text-1x;
	}
	.amnt {
		font-size: $fr-text-2x;
		color: $fr-green;
		font-weight: bold;
	}
	.btn {
		width: 100%;
	}
}

